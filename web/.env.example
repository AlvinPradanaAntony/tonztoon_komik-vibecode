# Server only. Copy to .env.local when backend integration begins.
# The phase 1 starter runs without these values and makes no backend requests.
BACKEND_BASE_URL=http://127.0.0.1:8000
ADMIN_WEB_ORIGIN=http://localhost:3000

# Phase 2 frontend only, explicitly opt in on a local/isolated environment.
# Does not enable backend authentication or production mutations.
ADMIN_FRONTEND_DEMO=false

# Use a database role restricted to admin sessions. No real credentials here.
ADMIN_SESSION_DATABASE_URL=

# Generate a private key on the server during phase 3; never use NEXT_PUBLIC_.
ADMIN_SESSION_ENCRYPTION_KEY=
